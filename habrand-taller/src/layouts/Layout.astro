---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/halogo.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Style+Script&display=swap"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			document.documentElement.classList.add('fonts-loading');

			const listo = () => document.documentElement.classList.remove('fonts-loading');

			Promise.all([
				document.fonts.load('italic 100px "Style Script"'),
				document.fonts.load('italic 1em "Poppins"'),
				document.fonts.load('900 1em "Poppins"'),
			]).then(listo, listo);

			// Seguro por si algo falla: nunca dejes la página esperando más de 2 segundos
			setTimeout(listo, 2000);
		</script>
		<title>HABrand</title>
	</head>
	<body>
		<slot />
	</body>
</html>


<style is:global>
	html.fonts-loading .anim-rise {
	animation-play-state: paused;
	}
    /* Animaciones de entrada: solo opacidad/transform en keyframes,
       con fill-mode "backwards" para no pisar los hover ni las utilidades de Tailwind */
    @keyframes rise {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    @keyframes pop {
        from { opacity: 0; transform: scale(0.92) translateY(8px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
    }
    @keyframes draw {
        from { stroke-dashoffset: 30; }
        to   { stroke-dashoffset: 0; }
    }
    @keyframes pulse-ring {
        0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.45); }
        70%  { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
        100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
    }

    /* Carga de la portada */
    .anim-rise { animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
    .anim-fade { animation: fade 0.9s ease-out var(--d, 0ms) backwards; }

    /* Aparición al hacer scroll (se activa con IntersectionObserver) */
    .reveal { opacity: 0; }
    .reveal.is-visible {
        opacity: 1;
        animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) backwards;
    }

    /* Post-its: levísimo movimiento al pasar el cursor */
    .post-it { transition: scale 0.4s ease, rotate 0.4s ease; }
    @media (hover: hover) {
        .post-it:hover { scale: 1.03; rotate: -1deg; }
    }

    /* Modal de éxito */
    .modal-pop { animation: pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
    .check-draw {
        stroke-dasharray: 30;
        animation: draw 0.6s ease-out 0.25s backwards;
    }

    /* Botón de WhatsApp */
    .wp-pulse { animation: pulse-ring 3s ease-out 2s infinite; }

    /* Respeta a quienes prefieren menos movimiento */
    @media (prefers-reduced-motion: reduce) {
        .anim-rise, .anim-fade, .modal-pop, .check-draw, .wp-pulse,
        .reveal.is-visible { animation: none !important; }
        .reveal { opacity: 1; }
        .post-it { transition: none; }
    }
</style>
