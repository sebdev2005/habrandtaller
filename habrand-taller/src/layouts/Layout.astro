---
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/halogo.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Style+Script&family=Poppins:ital,wght@0,400;0,500;0,900;1,400&display=block"
		/>

		
		<link rel="preload" as="image" href="/fondo-beige.webp" />

		<script is:inline>
			document.documentElement.classList.add('fonts-loading');

			const listo = () => document.documentElement.classList.remove('fonts-loading');

			Promise.all([
				document.fonts.load('italic 100px "Style Script"'),
				document.fonts.load('italic 1em "Poppins"'),
				document.fonts.load('900 1em "Poppins"'),
			]).then(listo, listo);

			
			setTimeout(listo, 2500);
		</script>
		<title>HABrand</title>
	</head>
	<body class="bg-[#F3E9DD]">
		<slot />
	</body>
</html>

<style is:global>
	
	#presentacion { transition: opacity 0.4s ease; }
	html.fonts-loading #presentacion { opacity: 0; }

	html.fonts-loading .anim-rise,
	html.fonts-loading .anim-fade { animation-play-state: paused; }

	@keyframes rise {
		from { opacity: 0; transform: translateY(28px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	@keyframes fade {
		from { opacity: 0; }
		to   { opacity: 1; }
	}
	@keyframes pop {
		from { opacity: 0; transform: scale(0.92) translateY(8px); }
		to   { opacity: 1; transform: scale(1) translateY(0); }
	}
	@keyframes draw {
		from { stroke-dashoffset: 30; }
		to   { stroke-dashoffset: 0; }
	}
	@keyframes pulse-ring {
		0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.45); }
		70%  { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
		100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
	}

	
	.anim-rise { animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) backwards; }
	.anim-fade { animation: fade 0.9s ease-out var(--d, 0ms) backwards; }

	
	.reveal { opacity: 0; }
	.reveal.is-visible {
		opacity: 1;
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) backwards;
	}

	
	.post-it { transition: scale 0.4s ease, rotate 0.4s ease; }
	@media (hover: hover) {
		.post-it:hover { scale: 1.03; rotate: -1deg; }
	}


	.modal-pop { animation: pop 0.45s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
	.check-draw {
		stroke-dasharray: 30;
		animation: draw 0.6s ease-out 0.25s backwards;
	}

	.wp-pulse { animation: pulse-ring 3s ease-out 2s infinite; }

	
	@media (prefers-reduced-motion: reduce) {
		.anim-rise,
		.reveal.is-visible { animation-name: fade; }
		.modal-pop, .check-draw, .wp-pulse { animation: none; }
		.post-it { transition: none; }
	}
</style>