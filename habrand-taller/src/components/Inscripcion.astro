<section id="inscripcion" class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-[url('/fondo-beige.webp')] bg-no-repeat bg-cover px-5 sm:px-6 py-12">

    <h2 class="reveal font-script italic text-[#732140] text-[52px] sm:text-[70px] md:text-[85px] leading-tight mb-10 drop-shadow-sm text-center">
        Inscríbete aquí
    </h2>

    <form id="contacto" novalidate class="reveal flex flex-col w-full max-w-md gap-5 z-10 relative" style="--d:150ms">

        <div class="relative group">
            <input type="text" name="name" id="name" placeholder="Tu nombre completo"
                   class="w-full bg-[#732140] rounded-xl px-5 py-4 outline-none text-[#fff3ed] placeholder:text-[#fff3ed]/50 border-2 border-transparent focus:border-[#fff3ed]/30 focus:shadow-[0_0_15px_rgba(115,33,64,0.3)] transition-all duration-300 shadow-sm" >
            <p id="error-name" class="hidden absolute -bottom-5 left-2 text-[#c0392b] text-xs font-medium tracking-wide">Por favor escribe tu nombre completo</p>
        </div>

        <div class="relative group">
            <input type="email" name="email" id="email" placeholder="tuemail@gmail.com"
                   class="w-full bg-[#732140] rounded-xl px-5 py-4 outline-none text-[#fff3ed] placeholder:text-[#fff3ed]/50 border-2 border-transparent focus:border-[#fff3ed]/30 focus:shadow-[0_0_15px_rgba(115,33,64,0.3)] transition-all duration-300 shadow-sm">
            <p id="error-email" class="hidden absolute -bottom-5 left-2 text-[#c0392b] text-xs font-medium tracking-wide">Escribe un correo válido, ej: tunombre@gmail.com</p>
        </div>
        <div class="relative group">
            <input type="tel" name="telefono" id="telefono" placeholder="ej: 300 1234567"
                   class="w-full bg-[#732140] rounded-xl px-5 py-4 outline-none text-[#fff3ed] placeholder:text-[#fff3ed]/50 border-2 border-transparent focus:border-[#fff3ed]/30 focus:shadow-[0_0_15px_rgba(115,33,64,0.3)] transition-all duration-300 shadow-sm">
            <p id="error-numero" class="hidden absolute -bottom-5 left-2 text-[#c0392b] text-xs font-medium tracking-wide font-poppins">Escribe un numero valido, ej: 300 1234567</p>
        </div>

        <button type="submit"
                class="mt-4 bg-[#fff3ed] text-[#732140] font-poppins text-base sm:text-lg px-6 py-4 rounded-xl shadow-md hover:shadow-xl hover:bg-white hover:-translate-y-1 active:translate-y-0 active:shadow-sm transition-all duration-300 uppercase tracking-widest cursor-pointer">
            Inscribirme
        </button>
    </form>
</section>
<div id="alerta-exito" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm px-4">
    <div class="modal-pop bg-[#fff3ed] p-6 sm:p-8 rounded-2xl shadow-2xl max-w-sm w-full text-center flex flex-col items-center transform transition-all">

  
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-5 text-green-600 shadow-inner">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
        </div>

        <h3 class="text-[#732140] text-xl sm:text-2xl font-black mb-2">¡Pre-inscripción satisfactoria!</h3>
        <p class="text-[#732140]/80 text-sm font-medium mb-6">Ahora será redirigido a WhatsApp para formalizar el pago.</p>

      
        <div class="w-8 h-8 border-4 border-[#732140]/20 border-t-[#732140] rounded-full animate-spin"></div>
    </div>
</div>
<a id="btn-wp-flotante"
   href="#"
   target="_blank"
   rel="noopener noreferrer"
   aria-label="Escríbenos por WhatsApp"
   class="wp-pulse fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 bg-[#25D366] text-white rounded-full shadow-xl hover:bg-[#20b858] hover:scale-110 transition-transform duration-300 cursor-pointer">

   <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
       <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
   </svg>
</a>

<noscript>
    <style>
        .reveal { opacity: 1 !important; }
    </style>
</noscript>

<script>
  // Aparición suave de los elementos al entrar en pantalla
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach((el) => observer.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }

  const numeroWhatsApp = import.meta.env.PUBLIC_NUMERO_WP;
  const btnWpFlotante = document.getElementById('btn-wp-flotante');

  if (btnWpFlotante instanceof HTMLAnchorElement) {
    const mensajeFlotante = 'Hola, me gustaría tener más información sobre el taller';
    btnWpFlotante.href = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensajeFlotante)}`;
  }

  const form = document.querySelector<HTMLFormElement>('#contacto');

  if (!form) {
    throw new Error('No se encontró el formulario de inscripción.');
  }

  form.addEventListener('submit', function (evento) {
    evento.preventDefault();

    const nameInput = document.getElementById('name');
    const emailInput = document.getElementById('email');
    const telefonoInput = document.getElementById('telefono');

    const errorName = document.getElementById('error-name');
    const errorEmail = document.getElementById('error-email');
    const errorNumero = document.getElementById('error-numero');

    if (!(nameInput instanceof HTMLInputElement) || !(emailInput instanceof HTMLInputElement) || !(telefonoInput instanceof HTMLInputElement)) {
      return;
    }

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const telefono = telefonoInput.value.trim();

    let formularioValido = true;

    if (name === '') {
      errorName?.classList.remove('hidden');
      formularioValido = false;
    } else {
      errorName?.classList.add('hidden');
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      errorEmail?.classList.remove('hidden');
      formularioValido = false;
    } else {
      errorEmail?.classList.add('hidden');
    }

    const telefonoLimpio = telefono.replace(/\s/g, '');
    if (telefonoLimpio === '' || isNaN(Number(telefonoLimpio))) {
      errorNumero?.classList.remove('hidden');
      formularioValido = false;
    } else {
      errorNumero?.classList.add('hidden');
    }

    if (formularioValido) {
      const alerta = document.querySelector('#alerta-exito');
      alerta?.classList.remove('hidden');

      const mensaje = `Hola, mi nombre es ${name} y acabo de realizar mi pre-inscripción. Quiero formalizar mi pago.`;
      const urlWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensaje)}`;

      setTimeout(() => {
        window.location.href = urlWhatsApp;
      }, 3000);
    }
  });
</script>